{
  "name": "@repo/supabase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./admin": "./src/admin.ts",
    "./config": "./src/config.ts",
    "./fixtures/users-fixture": "./src/fixtures/users-fixture.ts",
    "./nextjs/proxy": "./src/nextjs/proxy.ts",
    "./nextjs/server": "./src/nextjs/server.ts"
  },
  "scripts": {
    "dev": "SUPABASE_PROJECT=formawork.ai_$(basename \"$(git rev-parse --show-toplevel)\") supabase start",
    "stop": "SUPABASE_PROJECT=formawork.ai_$(basename \"$(git rev-parse --show-toplevel)\") supabase stop",
    "supabase:reset": "SUPABASE_PROJECT=formawork.ai_$(basename \"$(git rev-parse --show-toplevel)\") supabase db reset && pnpm supabase:seed",
    "supabase:seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "next": "catalog:",
    "supabase": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@workspace/tsconfig": "workspace:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
