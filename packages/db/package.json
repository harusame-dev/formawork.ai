{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./pgschema": "./src/pgschema.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/glossary": "./src/schema/glossary.ts",
    "./schema/project": "./src/schema/project.ts",
    "./schema/segment": "./src/schema/segment.ts",
    "./schema/staff": "./src/schema/staff.ts",
    "./schema/translation-memory": "./src/schema/translation-memory.ts",
    "./schema/work": "./src/schema/work.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm db:pgschema:create && tsx --env-file-if-exists=.env src/migrate.ts",
    "db:pgschema:create": "tsx --env-file-if-exists=.env src/create-pg-schema.ts",
    "db:pgschema:drop": "tsx --env-file-if-exists=.env src/drop-pg-schema.ts",
    "db:reset": "pnpm db:pgschema:drop && pnpm db:migrate && pnpm db:seed",
    "db:seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "db:studio": "drizzle-kit studio",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/tsconfig": "workspace:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
